---
import { demoText } from "../../public/examples/demo-text.js";
interface Props { kind: "story" | "chart"; locale?: "en" | "ja" | "ko" | "zh-CN" | "zh-TW" }
const { kind, locale = "en" } = Astro.props;
const zh = locale === "zh-CN", text = demoText(locale);
const languages = [["ja", "日本語"], ["en", "English"], ["zh-TW", "繁體中文"], ["zh-CN", "简体中文"], ["ko", "한국어"]];
---
<section class="docs-demo docs-demo--player" data-player-kind={kind} data-ui-locale={locale} aria-label={text("Player example", "播放器示例")}>
  <fieldset><legend>{kind === "story" ? text("1. Choose a story", "1. 选择剧情") : text("1. Choose a chart", "1. 选择谱面")}</legend>
    <div class="docs-demo__presets" role="group" aria-label={text("Source", "数据来源")}>
      <button type="button" data-player-preset="haneoka" disabled aria-pressed="false">{kind === "story" ? (text("Our Notes: Treasure", "Our Notes 宝物")) : (text("Haneoka song", "本站歌曲"))}</button>
      <button type="button" data-player-preset="author" disabled aria-pressed="true">{text("Complete original example", "完整原创示例")}</button>
      <button type="button" data-player-preset="http" disabled aria-pressed="false">{text("JSON address", "JSON 地址")}</button>
      <button type="button" data-player-preset="file" disabled aria-pressed="false">{text("My JSON file", "自己的 JSON 文件")}</button>
    </div>
  </fieldset>
  <div data-player-panel="author"><p>{text("Start with the complete original file. Load it, then press Play to read the first line.", "从完整原创文件开始。加载后，你会看见示例画面，点击播放读第一句。")}</p><a href={kind === "story" ? (zh ? "/examples/story-zh.json" : "/examples/story.json") : "/examples/chart.json"} target="_blank" rel="noopener">{text("Open complete JSON", "打开完整 JSON")}</a> · <a href={kind === "story" ? (zh ? "/examples/story-zh.json" : "/examples/story.json") : "/examples/chart.json"} download>{text("Download JSON", "下载 JSON")}</a></div>
  <div data-player-panel="haneoka" hidden><p>{kind === "story" ? (text("Read the published Treasure story and its referenced game assets. The adapter prepares its runtime and model data for you.", "读取本站已发布的「宝物」剧情及它引用的游戏素材。无需自己拼接模型与运行资料。")) : (text("Read the public song and score with the default game theme.", "读取本站歌曲和实际谱面，使用默认游戏主题。"))}</p><label>{kind === "story" ? (text("Story ID", "剧情 ID")) : (text("Song ID", "歌曲 ID"))}<input type="text" data-player-public-id value={kind === "story" ? "millsage_004_1_02" : "100070"} /></label>{kind === "story" && <a href="https://haneoka.org/api/v1/stories/millsage_004_1_02?server=intl" target="_blank" rel="noopener">{text("Open the complete game story JSON", "打开完整游戏剧情资料 JSON")}</a>}</div>
  <div data-player-panel="http" hidden><label>{text("Address of the complete JSON file", "完整 JSON 文件的网址")}<input type="url" data-player-url /></label></div>
  <div data-player-panel="file" hidden><label>{text("Choose the JSON saved on your computer", "选择保存到电脑的 JSON")}<input type="file" accept=".json,application/json" data-player-file /></label><p>{text("Sample JSON resources still come from the example address. For your own resources, set their directory in Advanced parameters.", "示例 JSON 引用的背景和音频仍由示例网址提供；使用自己的资源时，在高级参数填素材目录。")}</p></div>
  <div class="docs-demo__actions" aria-label={text("2. Load", "2. 加载")}><button type="button" data-player-run disabled>{text("Load selected content", "加载所选内容")}</button><button type="button" data-player-cancel disabled>{text("Cancel loading", "取消加载")}</button><button type="button" data-player-dispose disabled>{text("Exit this player", "换内容前退出")}</button></div>
  <p role="status" aria-live="polite" data-player-status>{text("Preparing example…", "正在准备示例…")}</p>
  <div class="docs-demo__stage" data-player-stage aria-busy="false"></div>
  <div class="docs-demo__actions" aria-label={text("3. Playback", "3. 播放")}><button type="button" data-player-play disabled>{text("Play", "播放")}</button><button type="button" data-player-pause disabled>{text("Pause", "暂停")}</button>{kind === "story" && <button type="button" data-player-next disabled>{text("Next line", "下一句")}</button>}</div>
  <label>{text("Playback progress", "播放进度")}<input type="range" min="0" max={kind === "story" ? "1" : "8"} step={kind === "story" ? ".01" : ".1"} value="0" data-player-progress disabled /><output data-player-progress-label>0</output></label>
  <details><summary>{text("Advanced parameters and complete input — reload to apply", "高级参数与完整输入（修改后重新加载）")}</summary>
    <fieldset><legend>{text("Content language", "内容语言")}</legend><div class="docs-demo__languages">{languages.map(([value, label]) => <label><input type="radio" name={`player-${kind}-language`} value={value} data-player-language />{label}</label>)}</div></fieldset>
    <label>{text("Author language (locale)", "作者语言（locale）")}<input type="text" value={locale} data-player-locale /></label>
    <label>{text("Player input JSON (options are settings; document is the story or chart itself)", "播放器输入 JSON（options 是参数，document 是剧情或谱面本身）")}<textarea rows="10" spellcheck="false" data-player-config></textarea></label>
    <label>{kind === "story" ? (text("Jump to a story ratio (0–1)", "精确跳到剧情比例（0–1）")) : (text("Jump to media seconds", "精确跳到媒体秒数"))}<input type="number" min="0" max={kind === "story" ? "1" : undefined} step={kind === "story" ? ".1" : "1"} value={kind === "story" ? ".5" : "2"} data-player-seek-value /></label><button type="button" data-player-seek disabled>{text("Seek", "跳转")}</button>
    {kind === "chart" && <><label>{text("Playback option changes", "更新播放设置")}<textarea rows="4" data-player-options>{JSON.stringify({ rate: .8, volume: .3, settings: { noteSpeed: 5 } }, null, 2)}</textarea></label><button type="button" data-player-set-options disabled>{text("Apply options", "应用设置")}</button><label>{text("Game skin changes", "更换游戏皮肤")}<textarea rows="3" data-player-skin>{JSON.stringify({ noteSkin: "skin003", noteEffectSkin: "effect001Simple", noteSeGroup: 4 }, null, 2)}</textarea></label><button type="button" data-player-set-skin disabled>{text("Apply skin", "应用皮肤")}</button></>}
  </details>
  <details><summary>{text("Load log and error details", "加载记录与错误详情")}</summary><pre class="docs-demo__output" tabindex="0"><code data-player-output></code></pre><a href="/examples/player-demo.js" target="_blank" rel="noopener">{text("View this example's code", "查看页面示例代码")}</a></details>
</section>
<script>
  import { demoText } from "../../public/examples/demo-text.js";
  const bindingUrl = "/examples/player-demo.js";
  for (const root of document.querySelectorAll<HTMLElement>("[data-player-kind]")) {
    if (root.dataset.playerBound) continue;
    root.dataset.playerBound = "pending";
    void import(/* @vite-ignore */ bindingUrl).then(({ install }) => {
      install(root);
      root.dataset.playerBound = "ready";
      for (const button of root.querySelectorAll<HTMLButtonElement>("[data-player-run], [data-player-preset]")) button.disabled = false;
      const status = root.querySelector<HTMLElement>("[data-player-status]");
      if (status) status.textContent = demoText(root.dataset.uiLocale)("Not loaded yet", "尚未加载");
    }).catch((error) => {
      root.dataset.playerBound = "error";
      const status = root.querySelector<HTMLElement>("[data-player-status]");
      if (status) status.textContent = `${demoText(root.dataset.uiLocale)("Example setup failed; refresh: ", "示例初始化失败，请刷新：")}${error.message}`;
    });
  }
</script>
