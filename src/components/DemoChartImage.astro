---
import { demoText } from "../../public/examples/demo-text.js";
interface Props { locale?: "en" | "ja" | "ko" | "zh-CN" | "zh-TW" }
const { locale = "en" } = Astro.props;
const text = demoText(locale);
const languages = [["ja", "日本語"], ["en", "English"], ["zh-TW", "繁體中文"], ["zh-CN", "简体中文"], ["ko", "한국어"]];
---
<section class="docs-demo" data-image-demo data-ui-locale={locale} aria-label={text("Runnable chart image example", "谱面图片实际示例")}>
  <p>{text("Edit JSON, then request. The response shows real status, dimensions and cache headers; a successful GET previews the image and offers the returned bytes for download.", "修改 JSON 再发送请求。响应显示真实状态、尺寸与缓存头；GET 成功后预览图片并提供原响应下载。")}</p>
  <div class="docs-demo__presets" role="group" aria-label={text("Request", "请求方式")}><button type="button" data-image-preset="svg" disabled>SVG</button><button type="button" data-image-preset="png" disabled>PNG</button><button type="button" data-image-preset="head" disabled>HEAD</button><button type="button" data-image-preset="options" disabled>OPTIONS</button></div>
  <fieldset><legend>{text("Language", "语言")}</legend><div class="docs-demo__languages">{languages.map(([value, label]) => <label><input type="radio" name="image-demo-language" value={value} data-image-language />{label}</label>)}</div></fieldset>
  <label>{text("Request JSON", "请求 JSON")}<textarea rows="12" spellcheck="false" data-image-config>{JSON.stringify({ method: "GET", server: "intl", songId: "100070", difficulty: "expert", format: "svg", locale: "en", height: 360, download: 0, scoped: false }, null, 2)}</textarea></label>
  <div class="docs-demo__actions"><button type="button" data-image-run disabled>{text("Request image", "请求图片")}</button><button type="button" data-image-cancel disabled>{text("Cancel", "取消")}</button><button type="button" data-image-clear>{text("Clear preview", "清理预览")}</button></div>
  <div class="docs-demo__stage" style="height:22rem;overflow:auto" data-image-stage aria-busy="false"><img hidden data-image-preview alt={text("Actual chart overview response", "实际谱面概览响应")} style="max-width:none;height:auto;display:block" /></div>
  <a hidden data-image-download download="chart.svg">{text("Download response image", "下载响应图片")}</a>
  <p role="status" aria-live="polite" data-image-status>{text("Preparing example…", "正在准备示例…")}</p>
  <pre class="docs-demo__output" tabindex="0"><code data-image-output></code></pre>
  <a href="/examples/image-demo.js" target="_blank" rel="noopener">{text("View example source", "查看实际示例代码")}</a>
</section>
<script>
  import { demoText } from "../../public/examples/demo-text.js";
  const bindingUrl = "/examples/image-demo.js";
  for (const root of document.querySelectorAll<HTMLElement>("[data-image-demo]")) {
    if (root.dataset.imageBound) continue;
    root.dataset.imageBound = "pending";
    void import(/* @vite-ignore */ bindingUrl).then(({ install }) => {
      install(root);
      root.dataset.imageBound = "ready";
      for (const button of root.querySelectorAll<HTMLButtonElement>("[data-image-run], [data-image-preset]")) button.disabled = false;
      const status = root.querySelector<HTMLElement>("[data-image-status]");
      if (status) status.textContent = demoText(root.dataset.uiLocale)("Waiting for a request", "等待请求");
    }).catch((error) => {
      root.dataset.imageBound = "error";
      const status = root.querySelector<HTMLElement>("[data-image-status]");
      if (status) status.textContent = `${demoText(root.dataset.uiLocale)("Example setup failed; refresh: ", "示例初始化失败，请刷新：")}${error.message}`;
    });
  }
</script>

<style>
  [data-image-preview][hidden] { display: none; }
</style>
