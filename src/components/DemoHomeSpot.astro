---
interface Props { locale?: "en" | "zh-CN" }
const { locale = "en" } = Astro.props;
const zh = locale === "zh-CN";
import scene from "../../public/examples/home-spot/scene.json";
const languages = [["ja", "日本語"], ["en", "English"], ["zh-TW", "繁體中文"], ["zh-CN", "简体中文"], ["ko", "한국어"]];
---
<section class="docs-demo" data-spot-demo data-ui-locale={locale} aria-label={zh ? "场景实际示例" : "Runnable scene example"}>
  <p>{zh ? "修改参数并点击加载后创建场景。原创数据只有一个简小场景；选择、重播与 PNG 导出使用实际场景控制器。" : "Edit parameters and load to create the scene. The authored sample is one tiny scene; selection, replay and PNG export use its real scene controller."}</p>
  <div class="docs-demo__presets" role="group" aria-label={zh ? "输入方式" : "Input"}><button type="button" data-spot-preset="author">{zh ? "原创场景" : "Authored scene"}</button><button type="button" data-spot-preset="http">HTTP JSON</button><button type="button" data-spot-preset="file">{zh ? "本地文件" : "Local files"}</button><button type="button" data-spot-preset="haneoka">{zh ? "本站 ID" : "Haneoka ID"}</button></div>
  <fieldset><legend>{zh ? "语言" : "Language"}</legend><div class="docs-demo__languages">{languages.map(([value, label]) => <label><input type="radio" name="spot-demo-language" value={value} data-spot-language />{label}</label>)}</div></fieldset>
  <label>locale<input type="text" value="fr" data-spot-locale /></label>
  <label>{zh ? "参数 JSON" : "Parameters JSON"}<textarea rows="12" spellcheck="false" data-spot-config>{JSON.stringify({ input: "author", options: { locale: "fr", ariaLabel: "Scène originale", document: scene } }, null, 2)}</textarea></label>
  <label>{zh ? "本地 scene JSON（可选）" : "Local scene JSON (optional)"}<input type="file" accept=".json,application/json" data-spot-file /></label>
  <label>{zh ? "本地素材目录（file 用法）" : "Local resource folder (file input)"}<input type="file" webkitdirectory multiple data-spot-folder /></label>
  <div class="docs-demo__actions"><button type="button" data-spot-run>{zh ? "加载" : "Load"}</button><button type="button" data-spot-cancel disabled>{zh ? "取消" : "Cancel"}</button><button type="button" data-spot-exit disabled>{zh ? "退出并销毁" : "Exit and dispose"}</button></div>
  <div class="docs-demo__stage" style="height:auto;min-height:12rem;aspect-ratio:16/9" data-spot-stage aria-busy="false"></div>
  <label>{zh ? "选择角色 ID（0 清除）" : "Selected character ID (0 clears)"}<input type="text" value="1" data-spot-selection /></label>
  <div class="docs-demo__actions"><button type="button" data-spot-select disabled>{zh ? "选择" : "Select"}</button><button type="button" data-spot-replay disabled>{zh ? "重播" : "Replay"}</button><button type="button" data-spot-replace disabled>{zh ? "用当前 JSON 替换" : "Replace from JSON"}</button><button type="button" data-spot-resize disabled>{zh ? "更新视口" : "Resize"}</button></div>
  <label>{zh ? "exportPng 参数" : "exportPng options"}<textarea rows="3" data-spot-export-options>{JSON.stringify({ width: 512, height: 288 }, null, 2)}</textarea></label>
  <button type="button" data-spot-export disabled>{zh ? "导出 PNG" : "Export PNG"}</button>
  <a hidden data-spot-download download="authored-home-spot.png">{zh ? "下载 PNG" : "Download PNG"}</a>
  <p role="status" aria-live="polite" data-spot-status>{zh ? "等待加载" : "Waiting to load"}</p>
  <pre class="docs-demo__output" tabindex="0"><code data-spot-output></code></pre>
  <a href="/examples/spot-demo.js" target="_blank" rel="noopener">{zh ? "查看实际示例代码" : "View example source"}</a>
</section>
<script>
  const bindingUrl = "/examples/spot-demo.js";
  for (const root of document.querySelectorAll<HTMLElement>("[data-spot-demo]")) {
    if (root.dataset.spotBound) continue;
    root.dataset.spotBound = "true";
    void import(/* @vite-ignore */ bindingUrl).then(({ install }) => install(root));
  }
</script>
