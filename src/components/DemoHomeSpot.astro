---
import { demoText } from "../../public/examples/demo-text.js";
interface Props { locale?: "en" | "ja" | "ko" | "zh-CN" | "zh-TW" }
const { locale = "en" } = Astro.props;
const text = demoText(locale);
import scene from "../../public/examples/home-spot/scene.json";
const languages = [["ja", "日本語"], ["en", "English"], ["zh-TW", "繁體中文"], ["zh-CN", "简体中文"], ["ko", "한국어"]];
---
<section class="docs-demo" data-spot-demo data-ui-locale={locale} aria-label={text("Runnable scene example", "场景实际示例")}>
  <p>{text("Edit parameters and load to create the scene. The authored sample is one tiny scene; selection, replay and PNG export use its real scene controller.", "修改参数并点击加载后创建场景。原创数据只有一个简小场景；选择、重播与 PNG 导出使用实际场景控制器。")}</p>
  <div class="docs-demo__presets" role="group" aria-label={text("Input", "输入方式")}><button type="button" data-spot-preset="author" disabled>{text("Authored scene", "原创场景")}</button><button type="button" data-spot-preset="http" disabled>HTTP JSON</button><button type="button" data-spot-preset="file" disabled>{text("Local files", "本地文件")}</button><button type="button" data-spot-preset="haneoka" disabled>{text("Haneoka ID", "本站 ID")}</button></div>
  <fieldset><legend>{text("Language", "语言")}</legend><div class="docs-demo__languages">{languages.map(([value, label]) => <label><input type="radio" name="spot-demo-language" value={value} data-spot-language />{label}</label>)}</div></fieldset>
  <label>locale<input type="text" value="fr" data-spot-locale /></label>
  <label>{text("Parameters JSON", "参数 JSON")}<textarea rows="12" spellcheck="false" data-spot-config>{JSON.stringify({ input: "author", options: { locale: "fr", ariaLabel: "Scène originale", document: scene } }, null, 2)}</textarea></label>
  <label>{text("Local scene JSON (optional)", "本地 scene JSON（可选）")}<input type="file" accept=".json,application/json" data-spot-file /></label>
  <label>{text("Local resource folder (file input)", "本地素材目录（file 用法）")}<input type="file" webkitdirectory multiple data-spot-folder /></label>
  <div class="docs-demo__actions"><button type="button" data-spot-run disabled>{text("Load", "加载")}</button><button type="button" data-spot-cancel disabled>{text("Cancel", "取消")}</button><button type="button" data-spot-exit disabled>{text("Exit and dispose", "退出并销毁")}</button></div>
  <div class="docs-demo__stage" style="height:auto;aspect-ratio:16/9" data-spot-stage aria-busy="false"></div>
  <div class="docs-demo__presets" data-spot-characters role="group" aria-label={text("Scene characters", "场景角色")}></div>
  <label>{text("Selected character ID (0 clears)", "选择角色 ID（0 清除）")}<input type="text" value="1" data-spot-selection /></label>
  <div class="docs-demo__actions"><button type="button" data-spot-select disabled>{text("Select", "选择")}</button><button type="button" data-spot-replay disabled>{text("Replay", "重播")}</button><button type="button" data-spot-replace disabled>{text("Replace from JSON", "用当前 JSON 替换")}</button><button type="button" data-spot-resize disabled>{text("Resize", "更新视口")}</button></div>
  <label>{text("exportPng options", "exportPng 参数")}<textarea rows="3" data-spot-export-options>{JSON.stringify({ width: 512, height: 288 }, null, 2)}</textarea></label>
  <button type="button" data-spot-export disabled>{text("Export PNG", "导出 PNG")}</button>
  <a hidden data-spot-download download="authored-home-spot.png">{text("Download PNG", "下载 PNG")}</a>
  <p role="status" aria-live="polite" data-spot-status>{text("Preparing example…", "正在准备示例…")}</p>
  <pre class="docs-demo__output" tabindex="0"><code data-spot-output></code></pre>
  <a href="/examples/spot-demo.js" target="_blank" rel="noopener">{text("View example source", "查看实际示例代码")}</a>
</section>
<script>
  import { demoText } from "../../public/examples/demo-text.js";
  const bindingUrl = "/examples/spot-demo.js";
  for (const root of document.querySelectorAll<HTMLElement>("[data-spot-demo]")) {
    if (root.dataset.spotBound) continue;
    root.dataset.spotBound = "pending";
    void import(/* @vite-ignore */ bindingUrl).then(({ install }) => {
      install(root);
      root.dataset.spotBound = "ready";
      for (const button of root.querySelectorAll<HTMLButtonElement>("[data-spot-run], [data-spot-preset]")) button.disabled = false;
      const status = root.querySelector<HTMLElement>("[data-spot-status]");
      if (status) status.textContent = demoText(root.dataset.uiLocale)("Waiting to load", "等待加载");
    }).catch((error) => {
      root.dataset.spotBound = "error";
      const status = root.querySelector<HTMLElement>("[data-spot-status]");
      if (status) status.textContent = `${demoText(root.dataset.uiLocale)("Example setup failed; refresh: ", "示例初始化失败，请刷新：")}${error.message}`;
    });
  }
</script>
