---
import { demoText } from "../../public/examples/demo-text.js";
interface Props { kind: "api" | "core"; locale?: "en" | "ja" | "ko" | "zh-CN" | "zh-TW" }
const { kind, locale = "en" } = Astro.props;
const text = demoText(locale);
const presets = kind === "api"
  ? [["entity", "Entity", "实体"], ["page", "Page", "分页"], ["batch", "Batch", "批量"], ["servers", "Servers", "服务器"], ["index", "Index", "索引"], ["relation", "Relation", "关联"], ["image", "Image URL", "图片 URL"], ["get", "GET", "GET"], ["request", "Request", "请求"], ["response", "Response", "原始响应"], ["url", "URL", "URL"]]
  : [["memory", "Memory", "内存"], ["http", "HTTP JSON", "HTTP JSON"], ["file", "Local file", "本地文件"], ["haneoka", "Haneoka", "本站资料"]];
const languages = [["ja", "日本語"], ["en", "English"], ["zh-TW", "繁體中文"], ["zh-CN", "简体中文"], ["ko", "한국어"]];
const config = kind === "api"
  ? { operation: "entity", resource: "songs", id: "100070", scope: { server: "intl", locale: "en" }, client: { baseUrl: "https://haneoka.org/api/v1/" } }
  : { source: "memory", locale: "fr", maxBytes: 1048576, assetsBase: "https://docs.haneoka.org/examples/", data: { title: "Une promenade", background: "garden.svg" }, resourceKey: "garden.svg" };
---
<section class="docs-demo" data-demo-kind={kind} data-ui-locale={locale} aria-label={text("Runnable example", "可运行示例")}>
  <p>{text("Edit the JSON parameters, then load. Modules and requests start only after a click; results include the actual response and transport log.", "修改 JSON 参数，然后点击加载。模块和请求只在点击后启动；输出包含真实响应与传输记录。")}</p>
  <div class="docs-demo__presets" role="group" aria-label={text("Use case", "用法")}>
    {presets.map(([value, en, cn]) => <button type="button" data-demo-preset={value} disabled>{text(en, cn)}</button>)}
  </div>
  <fieldset><legend>{text("Language", "语言")}</legend><div class="docs-demo__languages">
    {languages.map(([value, label]) => <label><input type="radio" name={`demo-${kind}-language`} value={value} data-demo-language />{label}</label>)}
  </div></fieldset>
  <label>{text("locale (including your author's language)", "locale（可输入作者自己的语言）")}<input type="text" data-demo-author-locale value={kind === "core" ? "fr" : "en"} /></label>
  <label>{text("Parameters JSON", "参数 JSON")}<textarea data-demo-config rows="13" spellcheck="false">{JSON.stringify(config, null, 2)}</textarea></label>
  {kind === "core" && <label>{text("Local JSON (optional for the file example)", "本地 JSON（file 用法可选）")}<input type="file" accept=".json,application/json" data-demo-file /></label>}
  <div class="docs-demo__actions">
    <button type="button" data-demo-run disabled>{text("Load and run", "加载并运行")}</button>
    <button type="button" data-demo-cancel disabled>{text("Cancel", "取消")}</button>
    {kind === "core" && <><button type="button" data-demo-resource-url disabled>{text("Resolve resource URL", "解析资源 URL")}</button><button type="button" data-demo-resource-bytes disabled>{text("Read resource bytes", "读取资源字节")}</button><button type="button" data-demo-dispose disabled>{text("Dispose", "销毁")}</button></>}
  </div>
  <p role="status" data-demo-status aria-live="polite">{text("Preparing example…", "正在准备示例…")}</p>
  <pre class="docs-demo__output" tabindex="0" aria-label={text("Response and events", "响应与事件")}><code data-demo-output></code></pre>
  <a href="/examples/data-demo.js" target="_blank" rel="noopener">{text("View the example source", "查看实际示例代码")}</a>
</section>
<script>
  import { installDataDemos } from "./DemoDataClient";
  installDataDemos();
</script>
